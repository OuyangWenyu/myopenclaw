# =============================================================
# 成员接入自检配置 — 复制为 .env.member 并填写（.env.member* 已在 .gitignore）
#
# 用途: ./scripts/member-check.sh
# 规则:
#   - 填了 URL 就必须填 token（否则退出码 2 —— 不静默带病探测）
#   - URL 留空 = 该项未启用（报告显示 ⚪ 跳过，不算失败）
#   - token 向管理员获取；.env.member 本身永不入 git（本 .example 模板除外）
#   - ⚠️ 勿写 `export` 前缀（docker --env-file 会拒绝整个文件）；值不要加引号、不要写行尾注释
# 详细说明: docs/member-check.md
# =============================================================

# ── 服务器监控（团队服务器已部署，可直接用；token 找管理员）─────
SERVER_MONITORING_MCP_URL=https://10.48.0.81:8765/mcp
SERVER_MONITORING_MCP_TOKEN=

# ── 语雀知识库（团队服务器部署后回填 URL，零代码改动）─────────
YUQUE_MCP_URL=
YUQUE_MCP_TOKEN=
# 若指向内网自签 https：取消下行注释（wrapper 已把仓库 CA 挂到容器内 /ca/）
# YUQUE_MCP_CA=/ca/server-monitoring-ca.pem

# ── 仓库动态 · GitHub/GitCode 贡献统计（同上）──────────────────
REPO_SCANNER_MCP_URL=
REPO_SCANNER_MCP_TOKEN=
# 若指向内网自签 https：REPO_SCANNER_MCP_CA=/ca/server-monitoring-ca.pem
