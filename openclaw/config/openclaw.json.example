{
  "models": {
    "mode": "merge",
    "providers": {
      "moonshot": {
        "baseUrl": "https://api.moonshot.cn/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "kimi-k2.5",
            "name": "Kimi K2.5",
            "reasoning": false,
            "input": ["text", "image"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 256000,
            "maxTokens": 8192
          }
        ]
      },
      "deepseek": {
        "baseUrl": "https://api.deepseek.com",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-v4-flash",
            "name": "DeepSeek V4 Flash",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 128000,
            "maxTokens": 8192
          },
          {
            "id": "deepseek-chat",
            "name": "DeepSeek Chat (V3)",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 128000,
            "maxTokens": 8192
          }
        ]
      },
      "xiaomi": {
        "baseUrl": "https://api.xiaomimimo.com/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "mimo-v2.5",
            "name": "Xiaomi MiMo V2.5",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 1000000,
            "maxTokens": 128000
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "xiaomi/mimo-v2.5",
        "fallbacks": ["moonshot/kimi-k2.5"]
      },
      "thinkingDefault": "off",
      "reasoningDefault": "off",
      "models": {
        "deepseek/deepseek-v4-flash": { "alias": "DeepSeek" },
        "moonshot/kimi-k2.5": { "alias": "Kimi" },
        "deepseek/deepseek-chat": {},
        "xiaomi/mimo-v2.5": { "alias": "MiMo" }
      },
      "workspace": "/home/node/.openclaw/workspace"
    }
  },
  "messages": {
    "tts": {
      "provider": "xiaomi",
      "providers": {
        "xiaomi": {
          "apiKey": "${XIAOMI_API_KEY}",
          "model": "mimo-v2.5-tts",
          "speakerVoice": "mimo_default",
          "format": "mp3"
        }
      }
    }
  },
  "tools": {
    "profile": "coding",
    "exec": {
      "security": "full",
      "ask": "off"
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "controlUi": {
      "dangerouslyAllowHostHeaderOriginFallback": true
    },
    "auth": {
      "mode": "token"
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send"
      ]
    }
  },
  "channels": {
    "discord": {
      "enabled": false,
      "token": "__OPENCLAW_DISCORD_BOT_TOKEN__",
      "dmPolicy": "allowlist",
      "groupPolicy": "open",
      "allowFrom": []
    },
    "feishu": {
      "enabled": false,
      "appId": "__OPENCLAW_FEISHU_APP_ID__",
      "appSecret": "__OPENCLAW_FEISHU_APP_SECRET__",
      "domain": "feishu",
      "connectionMode": "websocket",
      "dmPolicy": "open",
      "groupPolicy": "open",
      "allowFrom": ["*"],
      "webhookPath": "/feishu/events",
      "reactionNotifications": "own",
      "typingIndicator": true,
      "resolveSenderNames": true
    },
    "dingtalk-connector": {
      "enabled": false,
      "dmPolicy": "open",
      "groupPolicy": "open",
      "requireMention": true,
      "accounts": {
        "__default__": {
          "name": "默认钉钉应用",
          "clientId": "__OPENCLAW_DINGTALK_CLIENT_ID__",
          "clientSecret": "__OPENCLAW_DINGTALK_CLIENT_SECRET__"
        }
      }
    }
  },
  "plugins": {
    "entries": {
      "moonshot": { "enabled": true },
      "deepseek": { "enabled": true }
    }
  }
}
