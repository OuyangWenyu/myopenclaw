.env
.env.local
.env.zhixun-bot
.env.tianyi-bot
# .secrets/ 目录由 git-crypt 加密，.gitattributes 中已声明

# ── 云盘配置（本机路径，不入 git） ──────────────────────────────
.cloud.conf

# ── 运行时数据（在宿主机 ~/.hermes、~/.openclaw、~/.claude、~/.cc-connect，不在本仓库）──

# ── Code intelligence index (auto-generated) ─────────────────────
.codegraph/

# ── Runtime logs ──────────────────────────────────────────────────
logs/

# ── macOS ────────────────────────────────────────────────────────
.DS_Store

# ── 允许提交的模板文件（显式覆盖上面的忽略规则） ─────────────────
!.env.example
!.env.zhixun-bot.example
!.env.tianyi-bot.example
!*/.env.example
!.cloud.conf.example
# Python
__pycache__/
.pytest_cache/
.venv/
.claude/worktrees/

