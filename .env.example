# =============================================================
# 全局环境变量模板 — 复制为 .env 并填写真实值
# =============================================================

# ── 通用 ─────────────────────────────────────────────────────
TZ=Asia/Shanghai

# ── LLM API Keys（Hermes + OpenClaw + Claude Code 共用）─────────
# DeepSeek — 各 agent 默认模型 deepseek-flash（V4.1 Flash，原生多模态）
DEEPSEEK_API_KEY=sk-...
# Xiaomi MiMo — 虾酱 TTS 语音回复（mimo-v2.5-tts），platform.xiaomimimo.com 申请
# 不填则虾酱的语音回复不可用（其余 agent 已不依赖此 key）
# XIAOMI_API_KEY=sk-...
# Moonshot — OpenClaw 备份模型 kimi-k2.6，Hermes opencode 可选
# MOONSHOT_API_KEY=sk-...
# OpenRouter（Hermes opencode 可选）
# OPENROUTER_API_KEY=xxxxx
# OpenAI（Hermes opencode 可选）
# OPENAI_API_KEY=sk-...

# ── Hermes ───────────────────────────────────────────────────
HERMES_PORT=8642
HERMES_CODER_PORT=8643
HERMES_FINANCE_PORT=8644
HERMES_DASHBOARD_PORT=9119
# ── GitHub 个人令牌（OuyangWenyu）— gh CLI + git clone 私有仓库 ──
# Hermes / Claude Code / 爱码士 共用。容器内以 GITHUB_TOKEN 传递。
# GH_TOKEN=github_pat_xxxx
# Gitcode personal access token（容器内以 GITCODE_TOKEN 传递，claude-code 访问 gitcode.com 私有仓库）
# GITCODE_TOKEN=xxxxx
# GitCode CLI token（OpenClaw/Hermes 容器内传递给 gc）
# GITCODE_TOKEN=gitcode_xxxxx
# Finance agent 飞书应用（独立于主 Hermes 的飞书 app）
# FINANCE_FEISHU_APP_ID=cli_xxxx
# FINANCE_FEISHU_APP_SECRET=xxxxx
# 道元 agent 飞书应用（文献学者，群内开放访问）
# DAOYUAN_FEISHU_APP_ID=cli_xxxx
# DAOYUAN_FEISHU_APP_SECRET=xxxxx
# 爱码士（hermes-coder）独立飞书应用（2026-10-13 接线）
# 若与已有的「爱码士应用」为同一应用，则与 LARK_CLI_IDM_APP_ID/SECRET 同值
# CODER_FEISHU_APP_ID=cli_xxxx
# CODER_FEISHU_APP_SECRET=xxxxx
# Hermes 飞书主动推送凭证（Morning Triage v2 每日汇总 + 其他主动通知）
# 不填则 fallback 到 LARK_CLI_APP_ID/SECRET（Hermes 飞书 bot 同一组凭证）
# FEISHU_APP_ID=cli_xxxx
# FEISHU_APP_SECRET=xxxxx
# ── repo-scanner MCP 每用户 Bearer（服务端 GIT_STATS_API_KEYS）──
# 由 scripts/ensure_issue_watcher_auth.py 幂等生成/合并；每个消费者一把 key，
# 不要共享单 token。GIT_STATS_API_KEYS 是 {"key":"user"} JSON。
# HERMES_REPO_SCANNER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TIANYI_BOT_REPO_SCANNER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ISSUE_NOTIFIER_MCP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GIT_STATS_API_KEYS={"<hermes-key>":"hermes","<tianyi-key>":"tianyi","<notifier-key>":"notifier"}
# issue-watcher / issue-notifier 容器运行的宿主 UID/GID（start.sh 自动注入；
# 直接 docker compose up 时回退 0:0=root）。Linux 部署填部署用户。
# HOST_UID=1000
# HOST_GID=1000
# ── issue-notifier（GitHub/GitCode 分配变动 → 飞书群）──────────
# watcher 用的 GitHub token：私有 org 仓库需 classic PAT（repo scope）；
# compose 不再转发 GH_TOKEN（最小权限）。此项为空时 GitHub 用匿名 API
# （仅公开仓库，60 请求/小时），Gitee/GitCode 仍需要 token。
# ISSUE_WATCHER_GITHUB_TOKEN=ghp_xxxxx
# 群：预报系统；hermes-coder 应用（CODER_FEISHU_*）需在群内。
# 人员映射在 ~/.myagentdata/issue-notifier/config.toml（不在 .env）。
# ISSUE_NOTIFIER_FEISHU_MODE=app
# ISSUE_NOTIFIER_FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 或 webhook 模式（二选一）：
# ISSUE_NOTIFIER_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# watcher 轮询间隔（秒）；notifier 轮询间隔（秒）
ISSUE_WATCHER_POLL_SECONDS=600
ISSUE_NOTIFIER_POLL_SECONDS=60
# 容器内可达的 Uptime Kuma push URL（主机里的 KUMA_PUSH_URL 用
# 127.0.0.1/localhost，容器内不可达；start.sh 会自动替换主机名）。
# 直接 docker compose up（不经 start.sh）时请自行填这一项。
# KUMA_PUSH_URL_DOCKER=http://uptime-kuma:3001/api/push/xxxx
# DNS-rebinding 白名单（默认已含容器名与回环；换服务名/端口时覆盖）
# MCP_ALLOWED_HOSTS=repo-scanner-mcp:8001,127.0.0.1:8001,localhost:8001
# MCP_ALLOWED_ORIGINS=http://repo-scanner-mcp:8001,http://127.0.0.1:8001,http://localhost:8001
# watcher 接管 issue/PR 当前状态后，宿主每日采集跳过 issues/PRs
# （过渡期单写者；合并服务稳定一周后退役宿主任务）
REPO_SCANNER_WATCH_OWNS_ISSUES=1
# ── 飞书私聊推送目标（cron job 投递用，二选一即可）────────────
# FEISHU_HOME_CHANNEL：你的私聊窗口 chat_id（oc_xxx），默认推荐
# LARK_USER_OPEN_ID：你的用户 Open ID（ou_xxx），不填则 fallback 到 FEISHU_HOME_CHANNEL
# FEISHU_HOME_CHANNEL=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LARK_USER_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ── 飞书 markdown 卡片化（镜像级补丁，per-container 开关）──────────
# Hermes 镜像构建时把 markdown 回复改发飞书卡片（Card JSON 2.0）——标题/列表/表格真渲染。
# 留空/1/on = 启用（默认）；填 0/off/false/no 可单容器回退旧 post 渲染（改后 up -d 重建容器）
# FEISHU_MARKDOWN_CARD=off
# ── 飞书公式→图片（镜像级补丁，依赖卡片化开启）────────────────
# 回复里的 $...$（行内）/$$...$$（块级）用 matplotlib mathtext 渲染成图嵌进卡片；
# 渲染/上传失败自动回退源码文本。留空/1/on = 启用（默认）；0/off/false/no 关闭。
# FEISHU_LATEX_IMAGE=off
# ── 语雀 MCP（yuque-mcp，本机服务，仅 myopenclaw-net 内可达）──────────
# 客户端用本机服务名直连（docker-compose.yml 的 yuque-mcp 服务，不发布宿主端口）
YUQUE_MCP_URL=http://yuque-mcp:18001/sse
# 与服务端 MCP_API_KEY 对应的访问 key（bootstrap_hermes.sh 会写入 ~/.hermes/.env）
# MCP_YUQUE_MCP_API_KEY=xxxxx
# 语雀只读 token（服务端自持，客户端不需要）—— 语雀后台创建：repo:read + doc:read
# YUQUE_TOKEN=your_yuque_token_here
# 监控知识库：JSON 数组，name/namespace。**生效行**——注释掉会让服务端回退到内置
# 两库、静默丢掉「建设方案」，所以按本组织默认值写死（要改就改这里）
YUQUE_CHANGE_REPOS_JSON=[{"name":"技术交流","namespace":"kgo8gd/tnld77"},{"name":"建设方案","namespace":"kgo8gd/xnedwc"},{"name":"基础学习","namespace":"kgo8gd/owoc3p"}]
# ── 语雀每日变更推送（yuque-daily-digest，可选）──────────────
# 每日 8:10（北京）推送语雀知识库变更日报到飞书私聊，需已配置上面两项
# 填要跟踪的知识库显示名（逗号分隔），留空则不注册该 cron job
# YUQUE_DAILY_PUSH_REPOS=知识库显示名A,知识库显示名B
# ── lark-cli 飞书应用凭证（不填则自动绑定 Hermes 内置飞书应用）──
# LARK_CLI_APP_ID=cli_xxxx
# LARK_CLI_APP_SECRET=xxxxx
# 爱码士应用（第二个 profile，可选）
# LARK_CLI_IDM_APP_ID=cli_xxxx
# LARK_CLI_IDM_APP_SECRET=xxxxx
# Discord Bot（爱码士 — Hermes Discord 接入，可选）
# DISCORD_BOT_TOKEN=xxxxx
# DISCORD_ALLOWED_USERS=你的Discord用户ID
# ── Outlook 邮箱（OAuth 2.0，可选）─────────────────────────────
# OAuth 模型下没有邮箱密码——首次启动后在容器内跑一次
# `docker compose exec -u hermes -it hermes ortie auth get -a outlook`
# 完成微软登录授权，token 由 ortie 自动生成/续期（不经环境变量）。
# 全部变量均非机密；不填 EMAIL_OUTLOOK_ADDRESS 则整个功能关闭。
# EMAIL_OUTLOOK_ADDRESS=you@outlook.com
# EMAIL_OUTLOOK_DISPLAY_NAME=Wenyu Ouyang
# 账户名（himalaya/ortie 里的 id，默认 outlook）
# EMAIL_OUTLOOK_ACCOUNT_NAME=outlook
# 授权方式：device（无浏览器场景，推荐）| authorization-code
# EMAIL_OUTLOOK_GRANT=device
# 换自建 Azure 应用或自定义服务器时才需要覆盖以下项
# EMAIL_OUTLOOK_CLIENT_ID=9e5f94bc-e8a4-4e73-b8be-63364c29d753
# EMAIL_OUTLOOK_IMAP_HOST=outlook.office365.com
# EMAIL_OUTLOOK_IMAP_PORT=993
# EMAIL_OUTLOOK_SMTP_HOST=smtp.office365.com
# EMAIL_OUTLOOK_SMTP_PORT=587
# ── Zotero 文献系统 ─────────────────────────────────────────────
# 读取无需 API key（SQLite 直读）。创建/修改条目需要 Web API key。
# 在 https://www.zotero.org/settings/keys 创建 key（勾选 Allow library access）
# ZOTERO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# ZOTERO_LIBRARY_ID=1234567          # https://www.zotero.org/settings/keys 可查
# ZOTERO_LIBRARY_TYPE=user
# 注：DEEPSEEK/OPENROUTER/OPENAI 密钥被 Hermes 安全黑名单拦截，
# entrypoint 会自动将其写入 /opt/data/secrets/ 文件，opencode.json 用 {file:} 引用

# ── 论文清单（paper-queue）───────────────────────────────────────
# 虾酱只记不下；库在 ~/.myagentdata/paper-queue/，由独立容器 paper-queue-mcp 独占
# 读写（虾酱够不到那个目录，只能走 MCP 接口）。
# 签名密钥：插件与服务端共享，由 start.sh 首次运行时自动生成写入 .env，不要手改 ——
# 改了就两边不一致，表现是每次写入都被拒。轮换：删掉本行再跑一次 start.sh。
# PAPER_QUEUE_ACTOR_SECRET=
# PAPER_QUEUE_MCP_PORT=8003

# ── Google Drive Papers 本地路径（paper-to-zotero 工作流用）─────
# Google Drive 客户端本地同步路径下的 Papers 子目录
# GDRIVE_PAPERS_LOCAL_PATH=~/Google Drive/我的云端硬盘/Papers/Zotero_Papers

# ── Claude Code + cc-connect ────────────────────────────────
# 智谱 GLM — Claude Code 的 ANTHROPIC_API_KEY
# GLM_API_KEY=xxxxx.xxxxx
# 若需使用真实 Anthropic API 而非智谱，取消下行注释并清空 GLM_API_KEY
# ANTHROPIC_API_KEY=sk-ant-...
# cc-connect 飞书应用凭证（独立于 Hermes 的飞书 bot）
# CC_CONNECT_FEISHU_APP_ID=cli_xxxx
# CC_CONNECT_FEISHU_APP_SECRET=xxxxx
CC_CONNECT_PORT=9090
# opencode 专用 Key（不填则走默认 GLM）
# OPENCODE_API_KEY=xxxxx

# ── OpenClaw ─────────────────────────────────────────────────
OPENCLAW_PORT=18789
# Docker 镜像版本 —— **必须钉住，勿用 latest**。2.0 的配置 schema 有 breaking
# change（messages.tts→tts 等），混版本会让同一份模板在不同栈上有不同解释；
# 三个栈（主网关/zhixun/tianyi）的 pin 必须一致，守卫见 tests/test-openclaw-pins.sh。
# 升级流程（含 doctor --fix 要跑两遍、插件需与核心同版本）见 CLAUDE.md「升级流程」。
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.9.1
# ── 虾酱 Discord Bot Token ─────────────────────────────────
# OPENCLAW_DISCORD_BOT_TOKEN=xxxxx
# ── 虾酱飞书应用凭证（团队飞书自建应用）──────────────────
# 虾酱飞书 bot 的身份，与 Discord 虾酱是同一个 OpenClaw 网关
# OPENCLAW_FEISHU_APP_ID=cli_xxxx
# OPENCLAW_FEISHU_APP_SECRET=xxxxx
# ── 虾酱钉钉应用凭证 ─────────────────────────────────────
# OPENCLAW_DINGTALK_CLIENT_ID=dingxxxxx
# OPENCLAW_DINGTALK_CLIENT_SECRET=xxxxx
# ── GitHub 团队令牌（iHeadWater-bot）— OpenClaw MCP server 用 ──
# 权限低于个人令牌，仅用于创建/管理 issue。
# OPENCLAW_GH_TOKEN=ghp_xxxx

# ── paper-fetch skill（公开论文 PDF 下载器）────────────────────
# 设置 Unpaywall 联系邮箱可提高 OA 命中率（可选）
# UNPAYWALL_EMAIL=you@example.com
# 关闭 Sci-Hub 兜底（默认开启，作为最后回退源）
# PAPER_FETCH_NO_SCIHUB=1

# ── Uptime Kuma（服务监控面板）───────────────────────────────
UPTIME_KUMA_PORT=3001
# 管理员账号（首次访问 http://localhost:3001 创建管理员时使用；脚本不读取这两个值）
UPK_USER=admin
UPK_PASS=your_password_here

# ── TDAI Memory Gateway（Agent 长期记忆 L0→L3 分层管线）─────────
TDAI_MEMORY_PORT=8420
# LLM 后端（L1→L3 抽取用，默认复用 DeepSeek）
# TDAI_LLM_BASE_URL=https://api.deepseek.com/v1
# TDAI_LLM_MODEL=deepseek-chat

# ── Healthchecks.io（死信开关 — 整机/Docker 全崩时独立告警）───
# 在 https://healthchecks.io 创建 Check，将 Ping URL 填到这里
# 格式: https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# HEALTHCHECKS_PING_URL=https://hc-ping.com/your-uuid-here

# ── 备份（backup-cron 容器）─────────────────────────────────
# cron 表达式：默认每天凌晨 2:00 备份一次（对齐 AgentOps 24h 过期阈值）
BACKUP_CRON=0 2 * * *
# 快照保留天数（超过后自动删除旧快照；仅定时任务执行，容器重启不会删）
BACKUP_KEEP_DAYS=30
# 备份根目录（宿主机路径）—— 不在这里填写！
# 由 scripts/start.sh 从 .cloud.conf 解析后 export，再传给 docker compose。
# ⚠️ 不走 start.sh 就启动 backup-cron，docker-compose.yml 会静默回退到
#    /tmp/myopenclaw-backups（macOS 每天清理 /tmp），所以容器启动时有守卫
#    校验：未配置即拒绝启动，不会静默写进错误目录。
