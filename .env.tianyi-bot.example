# Tianyi (天一) Feishu Bot configuration.
# Copy to .env.tianyi-bot, fill in credentials, and DO NOT commit.
#
# Prerequisites: main stack must be running (./scripts/start.sh)
# Start: ./scripts/start-tianyi-bot.sh [--build]

TZ=Asia/Shanghai

# OpenClaw image version
TIANYI_BOT_OPENCLAW_IMAGE=docker.m.daocloud.io/openclaw/openclaw:2026.7.1

# Isolated data directory — must NOT overlap with ~/.openclaw
# TIANYI_BOT_DATA_DIR=~/.openclaw-tianyi

# ── Feishu app credentials ─────────────────────────────────────────────
TIANYI_BOT_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
TIANYI_BOT_FEISHU_APP_SECRET=replace_me

# ── Model config (DeepSeek-compatible) ──────────────────────────────────
TIANYI_BOT_MODEL_API_KEY=replace_me
TIANYI_BOT_MODEL_ID=deepseek-v4-pro
TIANYI_BOT_MODEL_BASE_URL=https://api.deepseek.com

# Streaming mode (false = plain text, true = streaming cards)
TIANYI_BOT_FEISHU_STREAMING=false

# ── GitHub and GitCode API tokens ───────────────────────────────────────
TIANYI_BOT_GITHUB_TOKEN=replace_me
TIANYI_BOT_GITCODE_TOKEN=replace_me

# ── Yuque MCP（远程语雀知识库，可选）────────────────────────────────
# 服务端已部署语雀 MCP SSE，客户端只需 URL + API key（Bearer 鉴权）。
# 不配置则 tianyi 不带 yuque-mcp 能力。
TIANYI_BOT_YUQUE_MCP_URL=https://你的服务器/sse
TIANYI_BOT_MCP_YUQUE_MCP_API_KEY=replace_me
