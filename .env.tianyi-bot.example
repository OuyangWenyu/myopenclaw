# Tianyi (天一) Feishu Bot configuration.
# Copy to .env.tianyi-bot, fill in credentials, and DO NOT commit.
#
# Prerequisites: main stack must be running (./scripts/start.sh)
# Start: ./scripts/start-tianyi-bot.sh [--build]

TZ=Asia/Shanghai

# OpenClaw image version
TIANYI_BOT_OPENCLAW_IMAGE=docker.m.daocloud.io/openclaw/openclaw:2026.9.1

# Isolated data directory — must NOT overlap with ~/.openclaw
# TIANYI_BOT_DATA_DIR=~/.openclaw-tianyi

# ── Feishu app credentials ─────────────────────────────────────────────
TIANYI_BOT_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
TIANYI_BOT_FEISHU_APP_SECRET=replace_me

# ── Model config (DeepSeek-compatible) ──────────────────────────────────
TIANYI_BOT_MODEL_API_KEY=replace_me
TIANYI_BOT_MODEL_ID=deepseek-flash
TIANYI_BOT_MODEL_BASE_URL=https://api.deepseek.com

# ── 兜底模型 GLM glm-5.3-flash（可选，建议配）──────────────────────────
# 主模型（DeepSeek）不可用时 OpenClaw 自动切换（agents.defaults.model.fallbacks =
# ["zhipu/glm-5.3-flash"]，与虾酱的兜底机制同款）。key 与主 .env 的 GLM_API_KEY 是
# **两份拷贝**——轮换时两处同改。不配 = 无兜底（其余能力不受影响）。
# TIANYI_BOT_GLM_API_KEY=replace_me

# Streaming mode (false = plain text, true = streaming cards)
TIANYI_BOT_FEISHU_STREAMING=false

# ── GitHub and GitCode API tokens ───────────────────────────────────────
TIANYI_BOT_GITHUB_TOKEN=replace_me
TIANYI_BOT_GITCODE_TOKEN=replace_me

# ── Yuque MCP（本机语雀知识库服务，可选）────────────────────────────
# 本机 yuque-mcp 服务（主栈 compose），客户端只需 URL + API key（Bearer 鉴权）。
# ⚠️ API key 是第二份拷贝（主 .env 的 MCP_YUQUE_MCP_API_KEY）—— 轮换时必须两处同改。
# 不需要语雀能力时**清空 URL**（URL 非空而 key 为空会让渲染直接报错、容器起不来）。
TIANYI_BOT_YUQUE_MCP_URL=http://yuque-mcp:18001/sse
TIANYI_BOT_MCP_YUQUE_MCP_API_KEY=replace_me

# ── Repo-scanner MCP（仓库动态，必需能力）──────────────────────────────
# 默认连主栈同网的 repo-scanner-mcp（http://repo-scanner-mcp:8001/mcp），无需配置。
# 仅当服务不在同一网络时（如天一部署到团队服务器后由外部消费）才覆盖：
# TIANYI_BOT_REPO_SCANNER_MCP_URL=http://<地址>:8001/mcp
# 每用户 repo-scanner MCP Bearer key（与 myopenclaw/.env 的同名变量一致；
# 由 scripts/ensure_issue_watcher_auth.py 生成，向管理员获取）
# TIANYI_BOT_REPO_SCANNER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Server Monitoring MCP（团队服务器监控，可选）──────────────────────
# 团队只读监控服务 server-monitoring（HTTPS + Bearer + 内网自签 CA）。
# 用途：问服务器/容器状态、rainfall-oa-data 的 GFS 处理进度、各项目 CI 构建情况。
# 详见 docs/server-monitoring-mcp.md
# 规则：
#   - URL 留空 = 关闭（渲染时移除 server-monitoring 条目，不注册该 MCP）；
#   - ⚠️ URL 非空而 token 为空会让渲染直接报错、容器起不来；
#   - CA 证书随仓库自带（docker/tianyi-bot/ca/），无需配置；
#   - token 是**全客户端共用的服务端凭据**，找团队维护者获取（服务器维护者
#     私有目录 .config/server-monitoring-mcp/auth_token），轮换时请联系维护者。
# 启用 = 取消注释下面一行，把 <MCP_HOST> 替换为内网 MCP 地址（真实地址见
# docs/server-monitoring-mcp.md 或找维护者要），并填 token：
# TIANYI_BOT_SERVER_MONITORING_MCP_URL=https://<MCP_HOST>:8765/mcp
# TIANYI_BOT_MCP_SERVER_MONITORING_TOKEN=replace_me
#
# ── 每日监控摘要推送（可选；需上面 URL 已启用）────────────────────────
# entrypoint 在网关上电后幂等声明一条 automation（declaration-key =
# tianyi-monitoring-daily，重启自动更新不重复），到点跑 agent 回合把服务器
# 日报推给下面这个人：
#   - TIANYI_BOT_OWNER_OPEN_ID：接收人的飞书 open_id（ou_ 开头）。
#     ⚠️ open_id 是**应用维度**的——必须是「天一的飞书应用」视角下该用户的 id；
#     填成别的应用（如 lark-cli 绑定的爱码士应用）视角的 id 会 99992361
#     "open_id cross app"。取法：从天一收到的该用户任意一条消息的记录里取
#     （~/.openclaw-tianyi/state/openclaw.sqlite 搜消息文本，邻近的 ou_ 即是）。
#   - TIANYI_BOT_MONITORING_DIGEST_CRON：排期（默认 30 8 * * *，Asia/Shanghai）；
#     设 off 显式关闭
# ⚠️ 本机（Mac）推送时需 UniVPN 在线；部署到内网服务器后无此约束。
# TIANYI_BOT_OWNER_OPEN_ID=ou_replace_me
# TIANYI_BOT_MONITORING_DIGEST_CRON=30 8 * * *
