# zhixun 飞书机器人专用配置。
# 复制为 .env.zhixun-bot 后填写。不要提交真实凭据。

TZ=Asia/Shanghai

# 仅 `--with-local-mcp` 调试模式需要：新版 zhixun-agent 仓库的绝对路径或相对
# 本仓库的路径。仓库需包含 mcp_servers/water/mcp_server_unified.py。
# 默认部署连远程 water MCP，不需要这个仓库，也不需要构建本地 MCP 镜像。
ZHIXUN_AGENT_PATH=../zhixun-agent

# 远程 water MCP（团队服务器上运行的新版 zhixun-agent）。
# 默认部署必须配置；本机容器只是 `--with-local-mcp` 调试用的回退。
# 当前团队远程端点：http://10.48.0.81:18202/mcp（streamable-http）
ZHIXUN_BOT_WATER_MCP_URL=replace_me
# 远程 MCP 的 Bearer key。只写在这里；OpenClaw 运行时展开，渲染产物不落盘。
ZHIXUN_BOT_WATER_MCP_TOKEN=replace_me
# 可选文件模式：将上面的 TOKEN 留空，文件只读挂载到容器并设置容器内路径。
# 文件须归 OpenClaw 运行 UID 所有、权限 0600；不与 TOKEN 同时使用。
# ZHIXUN_BOT_WATER_MCP_TOKEN_FILE=/run/secrets/water-mcp-token
# 远程端点协议：streamable-http（当前远程）| sse（本地默认回退）。
ZHIXUN_BOT_WATER_MCP_TRANSPORT=streamable-http

# 必须与主栈同版本（2.0 的配置 schema 有 breaking change，混版本会让同一份模板
# 在不同栈上有不同解释）。三栈一致性由 tests/test-openclaw-pins.sh 守卫。
ZHIXUN_BOT_OPENCLAW_IMAGE=docker.m.daocloud.io/openclaw/openclaw:2026.9.1

# 网络受限时替换为可访问的 Python 基础镜像和 PyPI 镜像。
# 例如：registry.example.com/library/python:3.12-slim
ZHIXUN_BOT_PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
ZHIXUN_BOT_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# zhixun-core 新版 API 根地址，无需修改 zhixun-core。
ZHIXUN_CORE_BASE_URL=https://ws.waterism.tech:8090/api/v2

# Water MCP 名称索引缓存目录与刷新策略。
# 首次按河道站/雨量站名称查询时，从各流域测站接口构建索引并持久化。
# ZHIXUN_BOT_MCP_DATA_DIR=/srv/myopenclaw-data/zhixun-water-mcp
ZHIXUN_MCP_STATION_INDEX_TTL_SECONDS=86400
ZHIXUN_MCP_STATION_INDEX_WORKERS=12

# 独立数据目录，不能指向现有 ~/.openclaw。
# 使用绝对路径最稳妥，例如 /srv/myopenclaw-data/openclaw-zhixun。
# 留空时 Compose 默认使用 ${HOME}/.openclaw-zhixun。
# ZHIXUN_BOT_DATA_DIR=/srv/myopenclaw-data/openclaw-zhixun

# 独立飞书自建应用凭据。
ZHIXUN_BOT_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
ZHIXUN_BOT_FEISHU_APP_SECRET=replace_me

# 机器人可被加入任意群（群内需 @机器人），也接受所有私聊；无需配置群 chat_id。

# false 使用普通文本回复，不显示流式回复卡片中的 Agent/Model/Provider 元信息。
# true 启用流式卡片，但会显示运行元信息。
ZHIXUN_BOT_FEISHU_STREAMING=false

# 机器人专用模型凭据，不会传给 myopenclaw 的其他服务。
# DeepSeek V4.1 Flash 使用 DeepSeek API Key；不能填写智谱等其他厂商的 Key。
ZHIXUN_BOT_MODEL_API_KEY=replace_me
ZHIXUN_BOT_MODEL_ID=deepseek-flash
ZHIXUN_BOT_MODEL_BASE_URL=https://api.deepseek.com

# ── 兜底模型 GLM glm-5.3-flash（可选，建议配）──────────────────────────
# 主模型（DeepSeek）不可用时 OpenClaw 自动切换（agents.defaults.model.fallbacks =
# ["zhipu/glm-5.3-flash"]）。固定走国内端点 https://open.bigmodel.cn/api/paas/v4。
# key 与主 .env 的 GLM_API_KEY 是**两份拷贝**——轮换时两处同改。
# 不配 = 无兜底（其余能力不受影响）。
# ZHIXUN_BOT_GLM_API_KEY=replace_me

# false：只开放查询类 MCP 工具（生产默认）。
# true：开放 briefing/dispatch/item 等创建、更新、删除和执行工具。
ZHIXUN_BOT_ENABLE_WRITE_TOOLS=false
