# cc-connect 配置 — Claude Code + 飞书
# 复制为 config.toml，cc-connect 会自动解析 ${VAR_NAME} 环境变量

language = "zh"

[log]
level = "info"

# ── Claude Code 项目 ──────────────────────────────────────────
[[projects]]
name = "claude-code"

[projects.agent]
type = "claudecode"

[projects.agent.options]
work_dir = "/home/node/code"
mode = "auto"

[projects.agent.options.env]
ANTHROPIC_BASE_URL = "https://api.deepseek.com/anthropic"
ANTHROPIC_MODEL = "deepseek-flash[1M]"
API_TIMEOUT_MS = "3000000"
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC = "1"
ANTHROPIC_DEFAULT_HAIKU_MODEL = "deepseek-flash"
ANTHROPIC_DEFAULT_SONNET_MODEL = "deepseek-flash[1M]"
ANTHROPIC_DEFAULT_OPUS_MODEL = "deepseek-flash[1M]"
ANTHROPIC_DEFAULT_FABLE_MODEL = "deepseek-flash[1M]"

# ── 飞书平台 ──────────────────────────────────────────────────
[[projects.platforms]]
type = "feishu"

[projects.platforms.options]
app_id = "${CC_CONNECT_FEISHU_APP_ID}"
app_secret = "${CC_CONNECT_FEISHU_APP_SECRET}"
